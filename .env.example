# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Auth & JWT Configuration
JWT_SECRET="your-jwt-secret-key"
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Admin Initial Credentials
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="SecurePassword123!"

# Email Notification Settings
NOTIFICATION_EMAIL="info@quickuppinstitute.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Quickupp Institute <info@quickuppinstitute.com>"


# Optional: where website enquiries are emailed (otherwise Admin → Settings)
# LEADS_NOTIFY_EMAIL="info@quickuppinstitute.com"

# Live site address used in receipt / password-reset links
NEXT_PUBLIC_SITE_URL="https://www.qimd.in"

# Scheduled reminders: call /api/cron/reminders hourly with this secret
CRON_SECRET=""

# Meta Lead Ads webhook (/api/webhooks/meta)
META_VERIFY_TOKEN=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""

# Online fee payments: gateways / your payment page call POST /api/payments/record with this key
PAYMENTS_API_KEY=""

# Website media bucket (images/videos uploaded from the admin panel)
# NEXT_PUBLIC_SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
