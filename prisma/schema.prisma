generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                String                    @id @default(uuid()) @db.Uuid
  fullName                          String                    @map("full_name") @db.VarChar(150)
  email                             String                    @unique @db.VarChar(255)
  passwordHash                      String                    @map("password_hash")
  phone                             String?                   @db.VarChar(20)
  role                              String                    @default("ADMIN") @db.VarChar(50)
  profileImage                      String?                   @map("profile_image")
  status                            Boolean                   @default(true)
  isDeleted                         Boolean                   @default(false) @map("is_deleted")
  lastLogin                         DateTime?                 @map("last_login")
  createdAt                         DateTime                  @default(now()) @map("created_at")
  updatedAt                         DateTime                  @updatedAt @map("updated_at")
  assignedAdmissionEnquiries        AdmissionEnquiry[]
  blogs                             Blog[]
  assignedCompanyPlacementEnquiries CompanyPlacementEnquiry[]
  assignedContactEnquiries          ContactEnquiry[]
  faqs                              Faq[]
  assignedFranchisePartnerEnquiries FranchisePartnerEnquiry[]
  galleryItems                      Gallery[]
  testimonials                      Testimonial[]

  @@index([email])
  @@index([status, isDeleted])
  @@map("users")
}

model Blog {
  id              String        @id @default(uuid()) @db.Uuid
  title           String        @db.VarChar(255)
  slug            String        @unique @db.VarChar(255)
  category        String?       @default("General") @db.VarChar(150)
  excerpt         String?
  featuredImage   String?       @map("featured_image")
  images          Json?
  tags            Json?
  author          String?       @db.VarChar(150)
  authorId        String?       @map("author_id") @db.Uuid
  readingTime     Int           @default(5) @map("reading_time")
  content         String
  metaTitle       String?       @map("meta_title") @db.VarChar(255)
  metaDescription String?       @map("meta_description")
  canonicalUrl    String?       @map("canonical_url")
  featured        Boolean       @default(false)
  status          ContentStatus @default(PUBLISHED)
  isActive        Boolean       @default(true) @map("is_active")
  isDeleted       Boolean       @default(false) @map("is_deleted")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  authorUser      User?         @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([authorId])
  @@index([status, isActive, isDeleted])
  @@index([featured])
  @@map("blogs")
}

model Placement {
  id             String    @id @default(uuid()) @db.Uuid
  studentName    String    @map("student_name") @db.VarChar(200)
  studentPhoto   String?   @map("student_photo")
  companyName    String    @map("company_name") @db.VarChar(200)
  companyLogo    String?   @map("company_logo")
  package        String?   @db.VarChar(100)
  designation    String?   @db.VarChar(150)
  courseName     String?   @map("course_name") @db.VarChar(150)
  placementDate  DateTime? @map("placement_date")
  location       String?   @db.VarChar(150)
  joiningYear    String?   @map("joining_year") @db.VarChar(50)
  isVideo        Boolean   @default(false) @map("is_video")
  videoUrl       String?   @map("video_url")
  videoThumbnail String?   @map("video_thumbnail")
  isVerified     Boolean   @default(true) @map("is_verified")
  successStory   String?   @map("success_story")
  featured       Boolean   @default(false)
  displayOrder   Int       @default(0) @map("display_order")
  isActive       Boolean   @default(true) @map("is_active")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isActive, isDeleted])
  @@index([featured])
  @@map("placements")
}

model Gallery {
  id           String    @id @default(uuid()) @db.Uuid
  album        String?   @db.VarChar(150)
  category     String?   @db.VarChar(150)
  mediaType    MediaType @default(IMAGE) @map("media_type")
  fileUrl      String    @map("file_url")
  thumbnail    String?
  altText      String?   @map("alt_text") @db.VarChar(255)
  caption      String?
  featured     Boolean   @default(false)
  displayOrder Int       @default(0) @map("display_order")
  createdById  String?   @map("created_by_id") @db.Uuid
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    User?     @relation(fields: [createdById], references: [id])

  @@index([album])
  @@index([category])
  @@index([mediaType])
  @@index([isDeleted])
  @@index([featured])
  @@map("gallery")
}

model Testimonial {
  id             String   @id @default(uuid()) @db.Uuid
  studentName    String   @map("student_name") @db.VarChar(200)
  heading        String?  @db.VarChar(255)
  photo          String?
  course         String?  @db.VarChar(150)
  role           String?  @db.VarChar(150)
  company        String?  @db.VarChar(150)
  rating         Int      @default(5)
  review         String
  isVideo        Boolean  @default(true) @map("is_video")
  videoUrl       String?  @map("video_url")
  videoThumbnail String?  @map("video_thumbnail")
  studentStory   String?  @map("student_story")
  featured       Boolean  @default(false)
  displayOrder   Int      @default(0) @map("display_order")
  createdById    String?  @map("created_by_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      User?    @relation(fields: [createdById], references: [id])

  @@index([isActive, isDeleted])
  @@index([featured])
  @@map("testimonials")
}

model StudentReview {
  id           String   @id @default(uuid()) @db.Uuid
  studentName  String   @map("student_name") @db.VarChar(200)
  photo        String?
  course       String?  @db.VarChar(150)
  rating       Int      @default(5)
  review       String
  company      String?  @db.VarChar(150)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, isDeleted])
  @@map("student_reviews")
}

model Faq {
  id           String   @id @default(uuid()) @db.Uuid
  question     String
  answer       String
  displayOrder Int      @default(0) @map("display_order")
  createdById  String?  @map("created_by_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    User?    @relation(fields: [createdById], references: [id])

  @@index([isActive, isDeleted])
  @@map("faqs")
}

model ContactEnquiry {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(150)
  email        String        @db.VarChar(255)
  phone        String        @db.VarChar(20)
  subject      String?       @db.VarChar(255)
  message      String
  status       EnquiryStatus @default(NEW)
  assignedToId String?       @map("assigned_to") @db.Uuid
  remarks      String?
  isDeleted    Boolean       @default(false) @map("is_deleted")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  assignedTo   User?         @relation(fields: [assignedToId], references: [id])

  @@index([status, isDeleted])
  @@index([assignedToId])
  @@map("contact_enquiries")
}

model AdmissionEnquiry {
  id            String        @id @default(uuid()) @db.Uuid
  studentName   String        @map("student_name") @db.VarChar(200)
  email         String        @db.VarChar(255)
  phone         String        @db.VarChar(20)
  city          String?       @db.VarChar(150)
  qualification String?       @db.VarChar(150)
  message       String?
  status        EnquiryStatus @default(NEW)
  assignedToId  String?       @map("assigned_to") @db.Uuid
  remarks       String?
  isDeleted     Boolean       @default(false) @map("is_deleted")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  assignedTo    User?         @relation(fields: [assignedToId], references: [id])

  @@index([status, isDeleted])
  @@index([assignedToId])
  @@map("admission_enquiries")
}

model JobOpening {
  id              String          @id @default(uuid()) @db.Uuid
  title           String          @db.VarChar(200)
  department      String?         @db.VarChar(150)
  location        String?         @default("Offline Classroom") @db.VarChar(150)
  jobType         String?         @default("Full-Time") @map("job_type") @db.VarChar(100)
  description     String
  requirements    String?
  displayOrder    Int             @default(0) @map("display_order")
  status          ContentStatus   @default(PUBLISHED)
  isActive        Boolean         @default(true) @map("is_active")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  careerEnquiries CareerEnquiry[]

  @@index([status, isActive, isDeleted])
  @@map("job_openings")
}

model CareerEnquiry {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(200)
  email        String        @db.VarChar(255)
  phone        String        @db.VarChar(20)
  jobTitle     String        @map("job_title") @db.VarChar(200)
  jobOpeningId String?       @map("job_opening_id") @db.Uuid
  resume       String
  coverLetter  String?       @map("cover_letter")
  status       EnquiryStatus @default(NEW)
  remarks      String?
  isDeleted    Boolean       @default(false) @map("is_deleted")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  jobOpening   JobOpening?   @relation(fields: [jobOpeningId], references: [id])

  @@index([status, isDeleted])
  @@index([jobOpeningId])
  @@map("career_enquiries")
}

model FranchisePartnerEnquiry {
  id                 String        @id @default(uuid()) @db.Uuid
  fullName           String        @map("full_name") @db.VarChar(200)
  companyName        String?       @map("company_name") @db.VarChar(255)
  email              String        @db.VarChar(255)
  phone              String        @db.VarChar(20)
  city               String?       @db.VarChar(150)
  state              String?       @db.VarChar(150)
  investmentCapacity String?       @map("investment_capacity") @db.VarChar(150)
  message            String?
  status             EnquiryStatus @default(NEW)
  assignedToId       String?       @map("assigned_to") @db.Uuid
  remarks            String?
  isDeleted          Boolean       @default(false) @map("is_deleted")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  assignedTo         User?         @relation(fields: [assignedToId], references: [id])

  @@index([status, isDeleted])
  @@index([assignedToId])
  @@map("franchise_partner_enquiries")
}

model CompanyPlacementEnquiry {
  id             String        @id @default(uuid()) @db.Uuid
  companyName    String        @map("company_name") @db.VarChar(255)
  contactPerson  String        @map("contact_person") @db.VarChar(200)
  email          String        @db.VarChar(255)
  phone          String        @db.VarChar(20)
  jobRole        String        @map("job_role") @db.VarChar(200)
  requiredSkills String?       @map("required_skills")
  vacancies      Int?          @default(1)
  jobLocation    String?       @map("job_location") @db.VarChar(200)
  message        String?
  status         EnquiryStatus @default(NEW)
  assignedToId   String?       @map("assigned_to") @db.Uuid
  remarks        String?
  isDeleted      Boolean       @default(false) @map("is_deleted")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  assignedTo     User?         @relation(fields: [assignedToId], references: [id])

  @@index([status, isDeleted])
  @@index([assignedToId])
  @@map("company_placement_enquiries")
}

model Banner {
  id           String   @id @default(uuid()) @db.Uuid
  badge        String?  @default("CAREER BOOSTER") @db.VarChar(100)
  title        String?  @db.VarChar(200)
  titleAccent  String?  @map("title_accent") @db.VarChar(200)
  subtitle     String?
  tag          String?  @db.VarChar(150)
  accentColor  String?  @default("#764DFF") @map("accent_color") @db.VarChar(50)
  icon         String?  @default("mdi:rocket-launch") @db.VarChar(100)
  imageUrl     String   @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, isDeleted])
  @@map("banners")
}

/// Central Bin: who moved a record to the Bin and when.
/// The record itself stays in its own table with is_deleted = true.
model TrashEntry {
  id            String   @id @default(uuid()) @db.Uuid
  entityType    String   @map("entity_type") @db.VarChar(50)
  entityId      String   @map("entity_id") @db.Uuid
  deletedById   String?  @map("deleted_by_id") @db.Uuid
  deletedByName String?  @map("deleted_by_name") @db.VarChar(150)
  deletedByRole String?  @map("deleted_by_role") @db.VarChar(50)
  deletedAt     DateTime @default(now()) @map("deleted_at")

  @@unique([entityType, entityId])
  @@index([deletedAt])
  @@map("trash_entries")
}

/// Notifications for the Super Admin (e.g. a user changed their password).
model AdminNotification {
  id         String   @id @default(uuid()) @db.Uuid
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(255)
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name") @db.VarChar(150)
  actorEmail String?  @map("actor_email") @db.VarChar(255)
  actorRole  String?  @map("actor_role") @db.VarChar(50)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("admin_notifications")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum Theme {
  LIGHT
  DARK
}

enum ReportFormat {
  PDF
  EXCEL
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum EnquiryStatus {
  NEW
  PENDING
  CONTACTED
  CLOSED
}

enum CareerStatus {
  NEW
  PENDING
  SHORTLISTED
  REJECTED
  HIRED
  CLOSED
}
