generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                String                    @id @default(uuid()) @db.Uuid
  fullName                          String                    @map("full_name") @db.VarChar(150)
  email                             String                    @unique @db.VarChar(255)
  passwordHash                      String                    @map("password_hash")
  phone                             String?                   @db.VarChar(20)
  role                              String                    @default("ADMIN") @db.VarChar(50)
  profileImage                      String?                   @map("profile_image")
  status                            Boolean                   @default(true)
  isDeleted                         Boolean                   @default(false) @map("is_deleted")
  lastLogin                         DateTime?                 @map("last_login")
  failedLoginCount                  Int                       @default(0) @map("failed_login_count")
  lockedUntil                       DateTime?                 @map("locked_until")
  lastFailedLogin                   DateTime?                 @map("last_failed_login")
  moduleAccess                      String?                   @map("module_access")
  username                          String?                   @unique @db.VarChar(60)
  passwordResetHash                 String?                   @map("password_reset_hash") @db.VarChar(128)
  passwordResetExpires              DateTime?                 @map("password_reset_expires")
  createdAt                         DateTime                  @default(now()) @map("created_at")
  updatedAt                         DateTime                  @updatedAt @map("updated_at")
  assignedAdmissionEnquiries        AdmissionEnquiry[]
  blogs                             Blog[]
  assignedCompanyPlacementEnquiries CompanyPlacementEnquiry[]
  assignedContactEnquiries          ContactEnquiry[]
  faqs                              Faq[]
  assignedFranchisePartnerEnquiries FranchisePartnerEnquiry[]
  galleryItems                      Gallery[]
  testimonials                      Testimonial[]
  assignedLeads                     Lead[]                    @relation("LeadAssignee")
  counselledAdmissions              Admission[]               @relation("AdmissionCounsellor")

  @@index([email])
  @@index([status, isDeleted])
  @@map("users")
}

model Blog {
  id              String        @id @default(uuid()) @db.Uuid
  title           String        @db.VarChar(255)
  slug            String        @unique @db.VarChar(255)
  category        String?       @default("General") @db.VarChar(150)
  excerpt         String?
  featuredImage   String?       @map("featured_image")
  images          Json?
  tags            Json?
  author          String?       @db.VarChar(150)
  authorId        String?       @map("author_id") @db.Uuid
  readingTime     Int           @default(5) @map("reading_time")
  content         String
  metaTitle       String?       @map("meta_title") @db.VarChar(255)
  metaDescription String?       @map("meta_description")
  canonicalUrl    String?       @map("canonical_url")
  featured        Boolean       @default(false)
  status          ContentStatus @default(PUBLISHED)
  isActive        Boolean       @default(true) @map("is_active")
  isDeleted       Boolean       @default(false) @map("is_deleted")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  authorUser      User?         @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([authorId])
  @@index([status, isActive, isDeleted])
  @@index([featured])
  @@map("blogs")
}

model Placement {
  id             String    @id @default(uuid()) @db.Uuid
  studentName    String    @map("student_name") @db.VarChar(200)
  studentPhoto   String?   @map("student_photo")
  companyName    String    @map("company_name") @db.VarChar(200)
  companyLogo    String?   @map("company_logo")
  package        String?   @db.VarChar(100)
  designation    String?   @db.VarChar(150)
  courseName     String?   @map("course_name") @db.VarChar(150)
  placementDate  DateTime? @map("placement_date")
  location       String?   @db.VarChar(150)
  joiningYear    String?   @map("joining_year") @db.VarChar(50)
  isVideo        Boolean   @default(false) @map("is_video")
  videoUrl       String?   @map("video_url")
  videoThumbnail String?   @map("video_thumbnail")
  isVerified     Boolean   @default(true) @map("is_verified")
  successStory   String?   @map("success_story")
  featured       Boolean   @default(false)
  displayOrder   Int       @default(0) @map("display_order")
  isActive       Boolean   @default(true) @map("is_active")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isActive, isDeleted])
  @@index([featured])
  @@map("placements")
}

model Gallery {
  id           String    @id @default(uuid()) @db.Uuid
  album        String?   @db.VarChar(150)
  category     String?   @db.VarChar(150)
  mediaType    MediaType @default(IMAGE) @map("media_type")
  fileUrl      String    @map("file_url")
  thumbnail    String?
  altText      String?   @map("alt_text") @db.VarChar(255)
  caption      String?
  featured     Boolean   @default(false)
  displayOrder Int       @default(0) @map("display_order")
  createdById  String?   @map("created_by_id") @db.Uuid
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    User?     @relation(fields: [createdById], references: [id])

  @@index([album])
  @@index([category])
  @@index([mediaType])
  @@index([isDeleted])
  @@index([featured])
  @@map("gallery")
}

model Testimonial {
  id             String   @id @default(uuid()) @db.Uuid
  studentName    String   @map("student_name") @db.VarChar(200)
  heading        String?  @db.VarChar(255)
  photo          String?
  course         String?  @db.VarChar(150)
  role           String?  @db.VarChar(150)
  company        String?  @db.VarChar(150)
  rating         Int      @default(5)
  review         String
  isVideo        Boolean  @default(true) @map("is_video")
  videoUrl       String?  @map("video_url")
  videoThumbnail String?  @map("video_thumbnail")
  studentStory   String?  @map("student_story")
  featured       Boolean  @default(false)
  displayOrder   Int      @default(0) @map("display_order")
  createdById    String?  @map("created_by_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      User?    @relation(fields: [createdById], references: [id])

  @@index([isActive, isDeleted])
  @@index([featured])
  @@map("testimonials")
}

model StudentReview {
  id           String   @id @default(uuid()) @db.Uuid
  studentName  String   @map("student_name") @db.VarChar(200)
  photo        String?
  course       String?  @db.VarChar(150)
  rating       Int      @default(5)
  review       String
  company      String?  @db.VarChar(150)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, isDeleted])
  @@map("student_reviews")
}

model Faq {
  id           String   @id @default(uuid()) @db.Uuid
  question     String
  answer       String
  displayOrder Int      @default(0) @map("display_order")
  createdById  String?  @map("created_by_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    User?    @relation(fields: [createdById], references: [id])

  @@index([isActive, isDeleted])
  @@map("faqs")
}

model ContactEnquiry {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(150)
  email        String        @db.VarChar(255)
  phone        String        @db.VarChar(20)
  subject      String?       @db.VarChar(255)
  message      String
  status       EnquiryStatus @default(NEW)
  assignedToId String?       @map("assigned_to") @db.Uuid
  remarks      String?
  isDeleted    Boolean       @default(false) @map("is_deleted")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  assignedTo   User?         @relation(fields: [assignedToId], references: [id])

  @@index([status, isDeleted])
  @@index([assignedToId])
  @@map("contact_enquiries")
}

model AdmissionEnquiry {
  id            String        @id @default(uuid()) @db.Uuid
  studentName   String        @map("student_name") @db.VarChar(200)
  email         String        @db.VarChar(255)
  phone         String        @db.VarChar(20)
  city          String?       @db.VarChar(150)
  qualification String?       @db.VarChar(150)
  message       String?
  status        EnquiryStatus @default(NEW)
  assignedToId  String?       @map("assigned_to") @db.Uuid
  remarks       String?
  isDeleted     Boolean       @default(false) @map("is_deleted")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  assignedTo    User?         @relation(fields: [assignedToId], references: [id])

  @@index([status, isDeleted])
  @@index([assignedToId])
  @@map("admission_enquiries")
}

model JobOpening {
  id              String          @id @default(uuid()) @db.Uuid
  title           String          @db.VarChar(200)
  department      String?         @db.VarChar(150)
  location        String?         @default("Offline Classroom") @db.VarChar(150)
  jobType         String?         @default("Full-Time") @map("job_type") @db.VarChar(100)
  description     String
  requirements    String?
  displayOrder    Int             @default(0) @map("display_order")
  status          ContentStatus   @default(PUBLISHED)
  isActive        Boolean         @default(true) @map("is_active")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  careerEnquiries CareerEnquiry[]

  @@index([status, isActive, isDeleted])
  @@map("job_openings")
}

model CareerEnquiry {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(200)
  email        String        @db.VarChar(255)
  phone        String        @db.VarChar(20)
  jobTitle     String        @map("job_title") @db.VarChar(200)
  jobOpeningId String?       @map("job_opening_id") @db.Uuid
  resume       String
  coverLetter  String?       @map("cover_letter")
  status       EnquiryStatus @default(NEW)
  remarks      String?
  isDeleted    Boolean       @default(false) @map("is_deleted")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  jobOpening   JobOpening?   @relation(fields: [jobOpeningId], references: [id])

  @@index([status, isDeleted])
  @@index([jobOpeningId])
  @@map("career_enquiries")
}

model FranchisePartnerEnquiry {
  id                 String        @id @default(uuid()) @db.Uuid
  fullName           String        @map("full_name") @db.VarChar(200)
  companyName        String?       @map("company_name") @db.VarChar(255)
  email              String        @db.VarChar(255)
  phone              String        @db.VarChar(20)
  city               String?       @db.VarChar(150)
  state              String?       @db.VarChar(150)
  investmentCapacity String?       @map("investment_capacity") @db.VarChar(150)
  message            String?
  status             EnquiryStatus @default(NEW)
  assignedToId       String?       @map("assigned_to") @db.Uuid
  remarks            String?
  isDeleted          Boolean       @default(false) @map("is_deleted")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  assignedTo         User?         @relation(fields: [assignedToId], references: [id])

  @@index([status, isDeleted])
  @@index([assignedToId])
  @@map("franchise_partner_enquiries")
}

model CompanyPlacementEnquiry {
  id             String        @id @default(uuid()) @db.Uuid
  companyName    String        @map("company_name") @db.VarChar(255)
  contactPerson  String        @map("contact_person") @db.VarChar(200)
  email          String        @db.VarChar(255)
  phone          String        @db.VarChar(20)
  jobRole        String        @map("job_role") @db.VarChar(200)
  requiredSkills String?       @map("required_skills")
  vacancies      Int?          @default(1)
  jobLocation    String?       @map("job_location") @db.VarChar(200)
  message        String?
  status         EnquiryStatus @default(NEW)
  assignedToId   String?       @map("assigned_to") @db.Uuid
  remarks        String?
  isDeleted      Boolean       @default(false) @map("is_deleted")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  assignedTo     User?         @relation(fields: [assignedToId], references: [id])

  @@index([status, isDeleted])
  @@index([assignedToId])
  @@map("company_placement_enquiries")
}

model Banner {
  id           String   @id @default(uuid()) @db.Uuid
  badge        String?  @default("CAREER BOOSTER") @db.VarChar(100)
  title        String?  @db.VarChar(200)
  titleAccent  String?  @map("title_accent") @db.VarChar(200)
  subtitle     String?
  tag          String?  @db.VarChar(150)
  accentColor  String?  @default("#764DFF") @map("accent_color") @db.VarChar(50)
  icon         String?  @default("mdi:rocket-launch") @db.VarChar(100)
  imageUrl     String   @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, isDeleted])
  @@map("banners")
}

/// Central Bin: who moved a record to the Bin and when.
/// The record itself stays in its own table with is_deleted = true.
model TrashEntry {
  id            String   @id @default(uuid()) @db.Uuid
  entityType    String   @map("entity_type") @db.VarChar(50)
  entityId      String   @map("entity_id") @db.Uuid
  deletedById   String?  @map("deleted_by_id") @db.Uuid
  deletedByName String?  @map("deleted_by_name") @db.VarChar(150)
  deletedByRole String?  @map("deleted_by_role") @db.VarChar(50)
  deletedAt     DateTime @default(now()) @map("deleted_at")

  @@unique([entityType, entityId])
  @@index([deletedAt])
  @@map("trash_entries")
}

/// Notifications for the Super Admin (e.g. a user changed their password).
model AdminNotification {
  id          String   @id @default(uuid()) @db.Uuid
  /// null = for Super Admins
  recipientId String?  @map("recipient_id") @db.Uuid
  link        String?  @db.VarChar(500)
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(255)
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name") @db.VarChar(150)
  actorEmail String?  @map("actor_email") @db.VarChar(255)
  actorRole  String?  @map("actor_role") @db.VarChar(50)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@index([recipientId, isRead])
  @@map("admin_notifications")
}

/// Leads CRM (SRS §7): website admission/contact enquiries, Meta leads, manual leads.
model Lead {
  id              String    @id @default(uuid()) @db.Uuid
  leadCode        String    @unique @default(dbgenerated("('LD-'::text || lpad((nextval('lead_code_seq'::regclass))::text, 6, '0'::text))")) @map("lead_code") @db.VarChar(20)
  source          String    @default("WEBSITE") @db.VarChar(20)
  enquiryType     String    @default("ADMISSION") @map("enquiry_type") @db.VarChar(20)
  fullName        String    @map("full_name") @db.VarChar(150)
  phone           String?   @db.VarChar(30)
  phoneNormalized String?   @map("phone_normalized") @db.VarChar(20)
  email           String?   @db.VarChar(255)
  course          String?   @db.VarChar(200)
  city            String?   @db.VarChar(120)
  qualification   String?   @db.VarChar(150)
  subject         String?   @db.VarChar(255)
  message         String?
  status          String    @default("NEW") @db.VarChar(30)
  statusReason    String?   @map("status_reason") @db.VarChar(255)
  assignedToId    String?   @map("assigned_to_id") @db.Uuid
  assignedTo      User?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt      DateTime? @map("assigned_at")
  nextFollowUpAt  DateTime? @map("next_follow_up_at")
  lastContactedAt DateTime? @map("last_contacted_at")
  duplicateOfId   String?   @map("duplicate_of_id") @db.Uuid
  campaign        String?   @db.VarChar(255)
  adId            String?   @map("ad_id") @db.VarChar(100)
  formId          String?   @map("form_id") @db.VarChar(100)
  sourceRef       String?   @unique @map("source_ref") @db.VarChar(150)
  rawPayload      Json?     @map("raw_payload")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdByName   String?   @map("created_by_name") @db.VarChar(150)
  updatedById     String?   @map("updated_by_id") @db.Uuid
  updatedByName   String?   @map("updated_by_name") @db.VarChar(150)
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  assignments     LeadAssignment[]
  followUps       LeadFollowUp[]
  admissions      Admission[]

  @@index([assignedToId, isDeleted])
  @@index([status, isDeleted])
  @@index([createdAt])
  @@index([phoneNormalized])
  @@index([email])
  @@map("leads")
}

/// Every assignment / reassignment of a lead (never overwritten).
model LeadAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUserId     String?  @map("from_user_id") @db.Uuid
  fromUserName   String?  @map("from_user_name") @db.VarChar(150)
  toUserId       String?  @map("to_user_id") @db.Uuid
  toUserName     String?  @map("to_user_name") @db.VarChar(150)
  assignedById   String?  @map("assigned_by_id") @db.Uuid
  assignedByName String?  @map("assigned_by_name") @db.VarChar(150)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("lead_assignments")
}

/// Counsellor follow-ups (SRS §8.1). History is kept in order and never overwritten.
model LeadFollowUp {
  id             String    @id @default(uuid()) @db.Uuid
  leadId         String    @map("lead_id") @db.Uuid
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followedAt     DateTime  @map("followed_at")
  remarks        String
  statusAfter    String?   @map("status_after") @db.VarChar(30)
  nextFollowUpAt DateTime? @map("next_follow_up_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdByName  String?   @map("created_by_name") @db.VarChar(150)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("lead_follow_ups")
}

/// Audit trail (SRS §15).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name") @db.VarChar(150)
  actorRole  String?  @map("actor_role") @db.VarChar(50)
  action     String   @db.VarChar(60)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  summary    String?  @db.VarChar(500)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum Theme {
  LIGHT
  DARK
}

enum ReportFormat {
  PDF
  EXCEL
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum EnquiryStatus {
  NEW
  PENDING
  CONTACTED
  INTERESTED
  FOLLOW_UP_REQUIRED
  COUNSELLING_SCHEDULED
  NOT_INTERESTED
  ADMISSION_CLOSED
  INVALID_DUPLICATE
  CLOSED
}

enum CareerStatus {
  NEW
  PENDING
  SHORTLISTED
  REJECTED
  HIRED
  CLOSED
}

/// Institute settings: institute details, courses, expense categories, emails (JSON per key).
model AppSetting {
  key           String   @id @db.VarChar(100)
  value         Json
  updatedById   String?  @map("updated_by_id") @db.Uuid
  updatedByName String?  @map("updated_by_name") @db.VarChar(150)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Official admission record (SRS §9), fields from the institute's admission form.
model Admission {
  id                   String    @id @default(uuid()) @db.Uuid
  admissionCode        String    @unique @default(dbgenerated("('ADM-'::text || lpad((nextval('admission_code_seq'::regclass))::text, 6, '0'::text))")) @map("admission_code") @db.VarChar(20)
  leadId               String?   @map("lead_id") @db.Uuid
  lead                 Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  counsellorId         String?   @map("counsellor_id") @db.Uuid
  counsellor           User?     @relation("AdmissionCounsellor", fields: [counsellorId], references: [id], onDelete: SetNull)
  counsellorName       String?   @map("counsellor_name") @db.VarChar(150)
  status               String    @default("VERIFICATION_PENDING") @db.VarChar(30)
  statusReason         String?   @map("status_reason") @db.VarChar(255)
  // Course
  courseName           String    @map("course_name") @db.VarChar(200)
  courseDurationMonths Int?      @map("course_duration_months")
  batchTiming          String?   @map("batch_timing") @db.VarChar(120)
  practicalBatchTiming String?   @map("practical_batch_timing") @db.VarChar(120)
  admissionDate        DateTime  @map("admission_date") @db.Date
  expectedCompletion   DateTime? @map("expected_completion") @db.Date
  // Personal
  studentName          String    @map("student_name") @db.VarChar(150)
  guardianName         String?   @map("guardian_name") @db.VarChar(150)
  gender               String?   @db.VarChar(20)
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  mobile               String    @db.VarChar(30)
  mobileNormalized     String?   @map("mobile_normalized") @db.VarChar(20)
  whatsapp             String?   @db.VarChar(30)
  email                String?   @db.VarChar(255)
  currentAddress       String?   @map("current_address")
  permanentAddress     String?   @map("permanent_address")
  // Education / profession
  highestQualification String?   @map("highest_qualification") @db.VarChar(60)
  qualificationOther   String?   @map("qualification_other") @db.VarChar(150)
  collegeSchool        String?   @map("college_school") @db.VarChar(200)
  yearOfPassing        String?   @map("year_of_passing") @db.VarChar(10)
  currentStatus        String?   @map("current_status") @db.VarChar(60)
  collegeCompany       String?   @map("college_company") @db.VarChar(200)
  // Fees
  totalFee             Decimal   @map("total_fee") @db.Decimal(12, 2)
  registrationFee      Decimal?  @map("registration_fee") @db.Decimal(12, 2)
  feeNote              String?   @map("fee_note")
  // Documents, emergency contact, declaration
  documentsSubmitted   Json?     @map("documents_submitted")
  emergencyName        String?   @map("emergency_name") @db.VarChar(150)
  emergencyRelation    String?   @map("emergency_relation") @db.VarChar(80)
  emergencyMobile      String?   @map("emergency_mobile") @db.VarChar(30)
  declarationAccepted  Boolean   @default(false) @map("declaration_accepted")
  verifiedById         String?   @map("verified_by_id") @db.Uuid
  verifiedByName       String?   @map("verified_by_name") @db.VarChar(150)
  verifiedAt           DateTime? @map("verified_at")
  createdById          String?   @map("created_by_id") @db.Uuid
  createdByName        String?   @map("created_by_name") @db.VarChar(150)
  updatedById          String?   @map("updated_by_id") @db.Uuid
  updatedByName        String?   @map("updated_by_name") @db.VarChar(150)
  isDeleted            Boolean   @default(false) @map("is_deleted")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  installments         FeeInstallment[]
  payments             Payment[]
  reminders            ReminderLog[]

  @@index([status, isDeleted])
  @@index([admissionDate])
  @@index([mobileNormalized])
  @@index([counsellorId])
  @@map("admissions")
}

/// Fee due schedule for an admission.
model FeeInstallment {
  id          String    @id @default(uuid()) @db.Uuid
  admissionId String    @map("admission_id") @db.Uuid
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  label       String    @db.VarChar(100)
  dueDate     DateTime  @map("due_date") @db.Date
  amount      Decimal   @db.Decimal(12, 2)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([admissionId])
  @@index([dueDate])
  @@map("fee_installments")
}

/// Every money movement is its own row and is never edited (SRS §2.1, §10).
/// kind: PAYMENT | REFUND | REVERSAL | ADJUSTMENT
model Payment {
  id                 String    @id @default(uuid()) @db.Uuid
  paymentCode        String    @unique @default(dbgenerated("('PAY-'::text || lpad((nextval('payment_code_seq'::regclass))::text, 6, '0'::text))")) @map("payment_code") @db.VarChar(20)
  receiptNo          String?   @unique @map("receipt_no") @db.VarChar(20)
  receiptToken       String?   @unique @map("receipt_token") @db.VarChar(64)
  admissionId        String    @map("admission_id") @db.Uuid
  admission          Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  kind               String    @default("PAYMENT") @db.VarChar(20)
  status             String    @default("SUCCESSFUL") @db.VarChar(20)
  amount             Decimal   @db.Decimal(12, 2)
  paidAt             DateTime  @map("paid_at")
  mode               String    @db.VarChar(30)
  loanBank           String?   @map("loan_bank") @db.VarChar(150)
  reference          String?   @db.VarChar(150)
  notes              String?
  relatedPaymentId   String?   @map("related_payment_id") @db.Uuid
  source             String    @default("MANUAL") @db.VarChar(20)
  gatewayTxnId       String?   @unique @map("gateway_txn_id") @db.VarChar(150)
  receiptEmailStatus String?   @map("receipt_email_status") @db.VarChar(20)
  receiptEmailError  String?   @map("receipt_email_error") @db.VarChar(500)
  receiptEmailedAt   DateTime? @map("receipt_emailed_at")
  recordedById       String?   @map("recorded_by_id") @db.Uuid
  recordedByName     String?   @map("recorded_by_name") @db.VarChar(150)
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([admissionId, createdAt])
  @@index([paidAt])
  @@index([status, kind])
  @@map("payments")
}

/// Fee reminders sent (internal and to students). uniqueKey stops duplicate sends.
model ReminderLog {
  id            String    @id @default(uuid()) @db.Uuid
  admissionId   String    @map("admission_id") @db.Uuid
  admission     Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  installmentId String?   @map("installment_id") @db.Uuid
  audience      String    @db.VarChar(20)
  stage         String    @db.VarChar(20)
  channel       String    @db.VarChar(20)
  dueDate       DateTime? @map("due_date") @db.Date
  amount        Decimal?  @db.Decimal(12, 2)
  uniqueKey     String    @unique @map("unique_key") @db.VarChar(255)
  status        String    @db.VarChar(20)
  error         String?   @db.VarChar(500)
  sentById      String?   @map("sent_by_id") @db.Uuid
  sentByName    String?   @map("sent_by_name") @db.VarChar(150)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([admissionId, createdAt])
  @@map("reminder_logs")
}

/// Expenses (SRS §12).
model Expense {
  id               String   @id @default(uuid()) @db.Uuid
  expenseCode      String   @unique @default(dbgenerated("('EXP-'::text || lpad((nextval('expense_code_seq'::regclass))::text, 6, '0'::text))")) @map("expense_code") @db.VarChar(20)
  expenseAt        DateTime @map("expense_at")
  category         String?  @db.VarChar(100)
  description      String   @db.VarChar(500)
  amount           Decimal  @db.Decimal(12, 2)
  paymentMode      String   @map("payment_mode") @db.VarChar(30)
  reference        String?  @db.VarChar(150)
  attachmentFileId String?  @map("attachment_file_id") @db.Uuid
  createdById      String?  @map("created_by_id") @db.Uuid
  createdByName    String?  @map("created_by_name") @db.VarChar(150)
  updatedById      String?  @map("updated_by_id") @db.Uuid
  updatedByName    String?  @map("updated_by_name") @db.VarChar(150)
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([expenseAt, isDeleted])
  @@map("expenses")
}

/// Private files (student documents, photos, bills). Stored in the database, served only through
/// an access-checked route — never from a public URL.
model StoredFile {
  id             String   @id @default(uuid()) @db.Uuid
  ownerType      String   @map("owner_type") @db.VarChar(30)
  ownerId        String?  @map("owner_id") @db.Uuid
  label          String?  @db.VarChar(120)
  originalName   String   @map("original_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  size           Int
  data           Bytes
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  uploadedByName String?  @map("uploaded_by_name") @db.VarChar(150)
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ownerType, ownerId])
  @@map("stored_files")
}
